digraph schema {
  rankdir=LR;
  bgcolor="transparent";
  graph [fontname="Helvetica", nodesep=0.28, ranksep=1.5, splines=spline, pad=0.25];
  node [shape=plaintext, fontname="Helvetica"];
  edge [color="#8b949e", penwidth=1.5, arrowsize=0.8];
  subgraph cluster_record {
    label="record — never edited"; labelloc=t; fontsize=14; fontname="Helvetica";
    fontcolor="#3fb950"; color="#30363d"; style=rounded; penwidth=1.2; margin=14;
    price_months [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3fb950" BGCOLOR="#161b22" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#0f2915" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Menlo" POINT-SIZE="15" COLOR="#3fb950"><B>price_months</B></FONT></TD></TR><TR><TD PORT="card_id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">card_id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>FK PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="tier" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">tier</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="month" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">month</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="observed_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">observed_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="price_cents" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">price_cents</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR></TABLE>>];
    populations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3fb950" BGCOLOR="#161b22" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#0f2915" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Menlo" POINT-SIZE="15" COLOR="#3fb950"><B>populations</B></FONT></TD></TR><TR><TD PORT="card_id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">card_id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>FK PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="grader" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">grader</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="grade" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">grade</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="observed_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">observed_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="population" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">population</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR></TABLE>>];
    sales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#3fb950" BGCOLOR="#161b22" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#0f2915" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Menlo" POINT-SIZE="15" COLOR="#3fb950"><B>sales</B></FONT></TD></TR><TR><TD PORT="id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="card_id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">card_id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#3fb950"><B>FK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="source_id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">source_id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="sold_on" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">sold_on</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="grade_tier" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">grade_tier</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="price_cents" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">price_cents</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="title" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">title</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR></TABLE>>];
  }
  subgraph cluster_catalog {
    label="catalog — mutable"; labelloc=t; fontsize=14; fontname="Helvetica";
    fontcolor="#58a6ff"; color="#30363d"; style=rounded; penwidth=1.2; margin=14;
    sets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#58a6ff" BGCOLOR="#161b22" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#12243b" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Menlo" POINT-SIZE="15" COLOR="#58a6ff"><B>sets</B></FONT></TD></TR><TR><TD PORT="id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#58a6ff"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="slug" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">slug</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#58a6ff"><B>UK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="name" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">name</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="discovered_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">discovered_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="last_walked_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">last_walked_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR></TABLE>>];
    cards [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#58a6ff" BGCOLOR="#161b22" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#12243b" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Menlo" POINT-SIZE="15" COLOR="#58a6ff"><B>cards</B></FONT></TD></TR><TR><TD PORT="id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#58a6ff"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="set_id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">set_id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#58a6ff"><B>FK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="url" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">url</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="name" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">name</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="last_visited_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">last_visited_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="observed_sales_per_day" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">observed_sales_per_day</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="any_bucket_at_cap" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">any_bucket_at_cap</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="failure_streak" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">failure_streak</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="quarantined_until" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">quarantined_until</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="delisted_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">delisted_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="not_a_card_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">not_a_card_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR></TABLE>>];
  }
  subgraph cluster_diary {
    label="diary — what happened"; labelloc=t; fontsize=14; fontname="Helvetica";
    fontcolor="#d29922"; color="#30363d"; style=rounded; penwidth=1.2; margin=14;
    visits [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#d29922" BGCOLOR="#161b22" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#2b2008" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Menlo" POINT-SIZE="15" COLOR="#d29922"><B>visits</B></FONT></TD></TR><TR><TD PORT="id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#d29922"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="card_id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">card_id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="fetched_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">fetched_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="http_status" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">http_status</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="outcome" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">outcome</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="fingerprint_hash" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">fingerprint_hash</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR></TABLE>>];
    fingerprints [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#d29922" BGCOLOR="#161b22" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#2b2008" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Menlo" POINT-SIZE="15" COLOR="#d29922"><B>fingerprints</B></FONT></TD></TR><TR><TD PORT="hash" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">hash</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#d29922"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="names" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">names</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="sample_url" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">sample_url</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="first_seen_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">first_seen_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="last_seen_at" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">last_seen_at</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR></TABLE>>];
    parse_failures [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#d29922" BGCOLOR="#161b22" STYLE="ROUNDED"><TR><TD COLSPAN="2" BGCOLOR="#2b2008" ALIGN="LEFT" CELLPADDING="7"><FONT FACE="Menlo" POINT-SIZE="15" COLOR="#d29922"><B>parse_failures</B></FONT></TD></TR><TR><TD PORT="id" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">id</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="9" COLOR="#d29922"><B>PK</B></FONT></TD></TR></TABLE></TD></TR><TR><TD PORT="url" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">url</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="reason" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">reason</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR><TR><TD PORT="fingerprint_hash" COLSPAN="2" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" WIDTH="200"><TR><TD ALIGN="LEFT" CELLPADDING="5"><FONT FACE="Menlo" POINT-SIZE="12" COLOR="#e6edf3">fingerprint_hash</FONT></TD><TD ALIGN="RIGHT" CELLPADDING="5"></TD></TR></TABLE></TD></TR></TABLE>>];
  }
  cards:set_id:e -> sets:id:w [arrowhead=normal];
  price_months:card_id:e -> cards:id:w [arrowhead=normal];
  populations:card_id:e -> cards:id:w [arrowhead=normal];
  sales:card_id:e -> cards:id:w [arrowhead=normal];
  visits:card_id:e -> cards:id:w [arrowhead=normal style=dashed];
  visits:fingerprint_hash:e -> fingerprints:hash:w [arrowhead=normal style=dashed];
  parse_failures:fingerprint_hash:e -> fingerprints:hash:w [arrowhead=normal style=dashed];
}
