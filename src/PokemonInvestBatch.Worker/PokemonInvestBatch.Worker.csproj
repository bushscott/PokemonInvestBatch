<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-PokemonInvestBatch.Worker-e882917d-fa1d-41c0-ba67-fdd2e29c5da7</UserSecretsId>
  </PropertyGroup>

  <!-- The intake API: Kestrel inside the worker process, loopback-only. The
       shared framework rides along in the self-contained publish (~30 MB on
       linux-arm64); see ADR-0006. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Hosting and Http come from the ASP.NET Core shared framework now;
       NU1510 (as error) rejects re-referencing them as packages. -->
  <ItemGroup>
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PokemonInvestBatch.Infrastructure\PokemonInvestBatch.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The lanes are the imperative shell: they hold concrete collaborators on
       purpose (see ADR-0003), so the test seam is the language's own rather
       than an interface invented for the tests. One iteration of a lane is
       internal; the loop around it is not worth testing. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PokemonInvestBatch.Worker.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
