              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT percentile(`crawl.visit_duration_seconds`, 50, 95) FROM Metric TIMESERIES SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
