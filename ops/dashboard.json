            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT latest(diskUsedPercent) AS '% used' FROM SystemSample"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 70
              },
              {
                "alertSeverity": "CRITICAL",
                "value": 80
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
