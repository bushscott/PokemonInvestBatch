          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT latest(`crawl.cards_quarantined_now`) AS 'benched' FROM Metric"
              }
            ],
