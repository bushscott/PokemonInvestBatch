              {
                "alertSeverity": "WARNING",
                "value": 10
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "New cards discovered per day",
          "layout": {
            "column": 10,
            "row": 13,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT derivative(`crawl.corpus_size`, 1 day) AS 'cards/day' FROM Metric TIMESERIES SINCE 7 days ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Live visit ticker",
          "layout": {
            "column": 1,
            "row": 25,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT `MESSAGE.Message` FROM Log WHERE `MESSAGE.Message` LIKE '%price rows%' OR message LIKE '%price rows%' SINCE 3 hours ago LIMIT 10"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Warnings and errors, 24h (click a row for full detail)",
          "layout": {
            "column": 1,
            "row": 29,
            "width": 12,
            "height": 4
          },
          "visualization": {
            "id": "logger.log-table-widget"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT * FROM Log WHERE `MESSAGE.LogLevel` IN ('Warning', 'Error', 'Critical') OR LogLevel IN ('Warning', 'Error', 'Critical') OR message LIKE '%\"LogLevel\":\"Warning\"%' OR message LIKE '%\"LogLevel\":\"Error\"%' OR message LIKE '%\"LogLevel\":\"Critical\"%' SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Slowest card visits, 24h",
          "layout": {
            "column": 9,
            "row": 22,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT max(duration.ms) AS 'ms' FROM Span WHERE name = 'card.visit' FACET `card.name` SINCE 1 day ago LIMIT 10"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Anatomy of a detail call (avg ms per phase)",
          "layout": {
            "column": 1,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT average(duration.ms) FROM Span WHERE name IN ('card.parse', 'card.load_history', 'card.write') OR (name IN ('site.wait', 'site.download') AND `url.path` LIKE '/game/%') FACET cases(WHERE name = 'site.wait' AS 'server wait', WHERE name = 'site.download' AS 'download', WHERE name = 'card.parse' AS 'parse', WHERE name = 'card.load_history' AS 'load history', WHERE name = 'card.write' AS 'write + commit') TIMESERIES SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Pi CPU (%): host vs scraper",
          "layout": {
            "column": 1,
            "row": 7,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT average(cpuPercent) AS 'host %' FROM SystemSample TIMESERIES SINCE 1 day ago"
              },
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT max(cpuPercent) AS 'scraper % (peak)' FROM ProcessSample WHERE (processDisplayName LIKE 'PokemonInvestBa%' OR processDisplayName LIKE 'pokemon-invest%') TIMESERIES SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Pi memory (%): host vs scraper",
          "layout": {
            "column": 5,
            "row": 7,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT average(memoryUsedBytes) / average(memoryTotalBytes) * 100 AS 'host %' FROM SystemSample TIMESERIES SINCE 1 day ago"
              },
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT average(memoryResidentSizeBytes) / 16781185024 * 100 AS 'scraper %' FROM ProcessSample WHERE (processDisplayName LIKE 'PokemonInvestBa%' OR processDisplayName LIKE 'pokemon-invest%') TIMESERIES SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Pi disk I/O (KB/s): host vs scraper",
          "layout": {
            "column": 8,
            "row": 7,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.line"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT (average(readBytesPerSecond) + average(writeBytesPerSecond)) / 1000 AS 'host' FROM StorageSample TIMESERIES SINCE 1 day ago"
              },
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT (max(ioReadBytesPerSecond) + max(ioWriteBytesPerSecond)) / 1000 AS 'scraper (peak)' FROM ProcessSample WHERE (processDisplayName LIKE 'PokemonInvestBa%' OR processDisplayName LIKE 'pokemon-invest%') TIMESERIES SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        }
      ]
    }
  ]
}