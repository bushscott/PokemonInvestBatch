          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT sum(`crawl.rows_appended`) / sum(`crawl.cards_visited`) AS 'rows per visit' FROM Metric TIMESERIES SINCE 24 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Higher grade selling cheaper than lower (wiggle is normal \u2014 a sudden jump means the site remapped grades)",
          "layout": {
