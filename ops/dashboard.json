        {
          "title": "Other server updates",
          "layout": {
            "column": 11,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT latest(`totalUpdates`) - latest(`securityUpdates`) AS 'pending' FROM AptUpdatesSample"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 0.5
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
