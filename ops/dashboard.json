{
  "name": "Pokemon Scraper",
  "description": "Crawl progress, yield, and data integrity at a glance. Import: replace accountIds 0 with your account id first.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Crawl health",
      "description": "Rows: alarms | right-now performance | the Pi | crawl progress | scheduler | database | integrity | site+forensics | logs.",
      "widgets": [
        {
          "title": "Politeness delay (s) \u2014 10 happy, 300 throttled",
          "layout": {
            "column": 1,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT latest(`crawl.delay_seconds`) AS 'seconds between requests' FROM Metric"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "WARNING",
                "value": 100
              },
              {
                "alertSeverity": "CRITICAL",
                "value": 290
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Crawl paused (too many site errors)",
          "layout": {
            "column": 3,
            "row": 1,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT latest(`crawl.lane_paused`) AS 'paused' FROM Metric"
              }
            ],
            "thresholds": [
              {
                "alertSeverity": "CRITICAL",
                "value": 1
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Cards visited, last hour",
          "layout": {
            "column": 4,
