        },
        {
          "title": "HTTP responses by status code, 24h",
          "layout": {
            "column": 5,
            "row": 4,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT sum(`crawl.requests`) FROM Metric FACET cases(WHERE `status` < 300 AS '2xx', WHERE `status` < 400 AS '3xx', WHERE `status` < 500 AS '4xx', WHERE `status` >= 500 AS '5xx') TIMESERIES SINCE 24 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Requests by lane, 24h",
          "layout": {
            "column": 1,
            "row": 22,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.pie"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT sum(`crawl.requests`) FROM Metric SINCE 24 hours ago FACET lane"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Rows appended by kind",
          "layout": {
            "column": 1,
            "row": 16,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT sum(`crawl.rows_appended`) FROM Metric FACET kind TIMESERIES SINCE 24 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Corpus coverage",
          "layout": {
            "column": 1,
            "row": 10,
            "width": 3,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT latest(`crawl.corpus_visited`) AS 'cards visited', latest(`crawl.corpus_size`) AS 'cards known' FROM Metric"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Total rows in Postgres (only goes up)",
          "layout": {
            "column": 5,
            "row": 16,
            "width": 4,
            "height": 3
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT latest(`crawl.total_rows`) FROM Metric FACET kind TIMESERIES SINCE 24 hours ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Days to full pass (at current pace)",
          "layout": {
            "column": 8,
            "row": 10,
            "width": 2,
            "height": 3
          },
          "visualization": {
            "id": "viz.billboard"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountIds": [
                  6565679
                ],
                "query": "SELECT (latest(`crawl.corpus_size`) - latest(`crawl.corpus_visited`)) / rate(sum(`crawl.cards_visited`), 1 day) AS 'days' FROM Metric SINCE 1 day ago"
              }
            ],
            "platformOptions": {
              "ignoreTimeRange": false
            }
          }
        },
        {
          "title": "Images pending",
          "layout": {
            "column": 10,
            "row": 10,
            "width": 3,
            "height": 3
          },
          "visualization": {
